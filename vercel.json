{
  "version": 2,
  "name": "reachinbox-email-onebox",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "@api_url"
  },
  "functions": {
    "backend/api/*.ts": {
      "runtime": "nodejs18.x"
    }
  }
}